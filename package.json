{
  "name": "generals",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:blog": "hugo --source blog --destination ../_site/generals --baseURL /generals/",
    "preview": "vite preview",
    "site": "npm run build:blog && npm run build && echo 'site: http://localhost:5174/generals/' && python3 -m http.server 5174 -d _site",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "onnxruntime-web": "^1.20.1"
  },
  "devDependencies": {
    "onnxruntime-node": "^1.20.1",
    "playwright": "^1.61.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
